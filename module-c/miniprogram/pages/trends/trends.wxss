/* ── 趋势页 v4 — 专属简报趋势 ── */
.container { padding: 20rpx 24rpx 80rpx; min-height: 100vh; background: var(--bg-page); }

/* 加载 */
.loading { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.loading-spinner { width: 48rpx; height: 48rpx; border: 3rpx solid var(--border-light); border-top-color: var(--primary-indigo); border-radius: 50%; animation: spin 0.8s linear infinite; }
.loading-text { margin-top: 24rpx; font-size: 26rpx; color: var(--text-tertiary); }

/* 空状态 */
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 160rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: var(--text-tertiary); margin-bottom: 36rpx; text-align: center; line-height: 1.6; }
.empty-btn {
  background: var(--gradient-personal);
  color: #fff; border-radius: 40rpx;
  padding: 18rpx 52rpx; font-size: 28rpx; font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(67,56,202,0.25);
}

/* 兴趣标识 */
.interest-hero {
  display: flex; align-items: center; gap: 20rpx;
  background: var(--gradient-personal);
  border-radius: var(--radius-xl); padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(67,56,202,0.2);
}
.ih-icon { font-size: 48rpx; }
.ih-body { flex: 1; }
.ih-title { font-size: 30rpx; font-weight: 700; color: #fff; display: block; margin-bottom: 12rpx; }
.ih-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.ih-tag { font-size: 22rpx; background: rgba(255,255,255,0.2); color: #fff; padding: 4rpx 16rpx; border-radius: 20rpx; }

/* 数据概览 */
.stats-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat {
  flex: 1; background: var(--bg-card); border-radius: var(--radius-lg);
  padding: 28rpx 16rpx 24rpx; text-align: center;
  box-shadow: var(--shadow-card); border: 1rpx solid var(--border-lighter);
  position: relative; overflow: hidden;
  transition: transform 0.2s var(--ease-out);
}
.stat:active { transform: scale(0.97); }
.stat::before {
  content: ''; position: absolute; top: -20rpx; right: -20rpx;
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--primary-light); opacity: 0.4;
}
.stat-num {
  font-size: 42rpx; font-weight: 800;
  background: linear-gradient(135deg, var(--primary), var(--primary-purple));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block; position: relative; z-index: 1;
}
.stat-label { font-size: 22rpx; color: var(--text-tertiary); margin-top: 6rpx; display: block; position: relative; z-index: 1; }

/* AI 趋势判断 */
.insight-card {
  background: linear-gradient(135deg, var(--bg-dark), #334155);
  border-radius: var(--radius-xl); padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
}
.insight-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 16rpx; }
.insight-icon { font-size: 36rpx; }
.insight-label { font-size: 26rpx; color: var(--text-tertiary); font-weight: 600; }
.insight-text { font-size: 28rpx; color: #e2e8f0; line-height: 1.75; }

/* 区块标题 */
.section-title { font-size: 28rpx; font-weight: 700; color: var(--text-primary); margin: 24rpx 0 16rpx; }

/* 雷达/热度列表 */
.radar-list {
  background: var(--bg-card); border-radius: var(--radius-lg);
  padding: 8rpx 20rpx; box-shadow: var(--shadow-card); border: 1rpx solid var(--border-lighter);
}
.radar-item { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--border-lighter); }
.radar-item:last-child { border-bottom: none; }
.radar-name { width: 120rpx; font-size: 26rpx; color: var(--text-secondary); font-weight: 500; flex-shrink: 0; }
.radar-bar { flex: 1; height: 10rpx; background: var(--border-lighter); border-radius: 5rpx; overflow: hidden; }
.radar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-indigo), var(--primary-purple));
  border-radius: 5rpx;
  transition: width 0.8s var(--ease-out);
}
.radar-count {
  width: 40rpx; text-align: right; font-size: 24rpx;
  color: var(--text-tertiary); font-weight: 600; flex-shrink: 0;
}

/* 时间线 */
.timeline { padding-left: 24rpx; }
.tl-day { display: flex; gap: 0; position: relative; }
.tl-dot-wrap { width: 40rpx; display: flex; flex-direction: column; align-items: center; flex-shrink: 0; }
.tl-dot {
  width: 16rpx; height: 16rpx; background: #cbd5e1;
  border-radius: 50%; margin-top: 20rpx;
  transition: all 0.3s var(--ease-out);
}
.tl-dot.today {
  background: var(--primary-indigo);
  box-shadow: 0 0 0 6rpx rgba(99,102,241,0.2);
  animation: pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(99,102,241,0.2); }
  50% { box-shadow: 0 0 0 12rpx rgba(99,102,241,0.08); }
}
.tl-line { width: 2rpx; flex: 1; background: var(--border-light); margin-top: 4rpx; }
.tl-card {
  flex: 1; background: var(--bg-card); border-radius: 14rpx;
  padding: 20rpx 22rpx; margin: 8rpx 0 0 12rpx;
  box-shadow: var(--shadow-xs); border: 1rpx solid var(--border-lighter);
  transition: all 0.2s var(--ease-out);
}
.tl-card:active { box-shadow: var(--shadow-sm); }
.tl-date-row { display: flex; align-items: center; gap: 12rpx; }
.tl-day-label { font-size: 28rpx; font-weight: 700; color: var(--text-primary); }
.tl-date { font-size: 24rpx; color: var(--text-tertiary); }
.tl-badge {
  font-size: 20rpx; background: var(--primary-light);
  color: var(--primary-indigo); padding: 2rpx 12rpx; border-radius: 10rpx;
  margin-left: auto; font-weight: 600;
}
.tl-events { margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid var(--border-lighter); }
.tl-event { margin-bottom: 14rpx; }
.tl-event:last-child { margin-bottom: 0; }
.tl-event-title { font-size: 26rpx; color: var(--text-secondary); font-weight: 600; display: block; margin-bottom: 4rpx; }
.tl-event-summary { font-size: 22rpx; color: var(--text-tertiary); display: block; line-height: 1.5; }
.tl-insight {
  margin-top: 14rpx; padding: 14rpx 18rpx;
  background: #fefce8; border-radius: 10rpx;
  font-size: 24rpx; color: #854d0e; line-height: 1.6;
  border-left: 4rpx solid #f59e0b;
}
