/* ══════════════════════════════════
   AI 新闻问答 — 对话页面
   ══════════════════════════════════ */

page {
  background: var(--bg-page);
  height: 100vh;
  overflow: hidden;
}

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ── 顶部标题栏 ── */
.chat-header {
  background: linear-gradient(145deg, #1e3a5f 0%, #4a6cf7 100%);
  padding: 20rpx 32rpx 24rpx;
  flex-shrink: 0;
}

.chat-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chat-title {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
}

.chat-home-btn {
  padding: 10rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  transition: all 0.15s;
}

.chat-home-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

.chat-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 4rpx;
  display: block;
}

/* ── 消息区域 ── */
.chat-body {
  flex: 1;
  padding: 24rpx;
  overflow-y: auto;
}

/* ── 欢迎区 ── */
.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
}

.welcome-avatar {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.welcome-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.welcome-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}

.suggestions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 32rpx;
}

.suggestion-chip {
  padding: 14rpx 24rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--border-light);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--primary);
  transition: all 0.15s;
}

.suggestion-chip:active {
  background: var(--primary-light);
  border-color: var(--primary);
}

/* ── 消息行 ── */
.msg-wrapper {
  display: flex;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.3s var(--ease-out) both;
}

.msg-left {
  justify-content: flex-start;
}

.msg-right {
  justify-content: flex-end;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.msg-left .msg-avatar {
  margin-right: 12rpx;
}

.msg-right .msg-avatar {
  margin-left: 12rpx;
}

.msg-body {
  max-width: 80%;
  display: flex;
  flex-direction: column;
}

/* ── 聊天气泡 ── */
.msg-bubble {
  padding: 18rpx 24rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.bubble-user {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  border-top-right-radius: 4rpx;
}

.bubble-ai {
  background: var(--bg-card);
  color: var(--text-primary);
  border-top-left-radius: 4rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border-light);
}

.msg-text {
  white-space: pre-wrap;
}

/* ── 新闻引用卡片 ── */
.source-card {
  margin-top: 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 20rpx;
  border: 1rpx solid var(--border-light);
  box-shadow: var(--shadow-xs);
}

.source-title {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 10rpx;
  font-weight: 600;
}

.source-item {
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--border-lighter);
  display: flex;
  flex-direction: column;
}

.source-item:last-child {
  border-bottom: none;
}

.source-item:active {
  opacity: 0.6;
}

.source-item-title {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.source-item-from {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}

/* ── 输入中动画 ── */
.typing-indicator {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.typing-dots {
  display: flex;
  gap: 8rpx;
  padding: 18rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-light);
  margin-left: 12rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--text-tertiary);
  animation: dotBounce 1.4s ease-in-out infinite both;
}

.dot:nth-child(1) { animation-delay: 0s; }
.dot:nth-child(2) { animation-delay: 0.16s; }
.dot:nth-child(3) { animation-delay: 0.32s; }

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.8); opacity: 0.4; }
  40% { transform: scale(1.2); opacity: 1; }
}

/* ── 底部输入区 ── */
.chat-footer {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-light);
  gap: 12rpx;
  flex-shrink: 0;
}

.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: var(--bg-page);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 1rpx solid transparent;
  transition: border-color 0.2s;
}

.chat-input:focus {
  border-color: var(--primary);
}

.send-btn {
  width: 120rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: var(--border-light);
  color: var(--text-tertiary);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  border: none;
  transition: all 0.2s;
}

.send-btn.active {
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.3);
}

.send-btn::after {
  border: none;
}
