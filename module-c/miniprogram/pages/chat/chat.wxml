<view class="chat-container">
  <!-- 顶部标题栏 -->
  <view class="chat-header">
    <view class="chat-header-top">
      <text class="chat-title">AI 新闻问答</text>
      <view class="chat-home-btn" bindtap="onGoHome">首页</view>
    </view>
    <text class="chat-subtitle">基于实时新闻数据回答</text>
  </view>

  <!-- 消息列表区域 -->
  <scroll-view
    class="chat-body"
    scroll-y
    scroll-with-animation
    scroll-into-view="{{scrollToId}}"
    enable-back-to-top
  >
    <!-- 空状态 / 欢迎 -->
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <view class="welcome-avatar">🤖</view>
      <view class="welcome-text">你好！我是AI新闻助手</view>
      <view class="welcome-hint">可以问我任何新闻相关的问题</view>
      <!-- 推荐话题 -->
      <view class="suggestions">
        <view
          class="suggestion-chip"
          wx:for="{{suggestions}}"
          wx:key="*this"
          data-topic="{{item}}"
          bindtap="onTopicTap"
        >{{item}}</view>
      </view>
    </view>

    <!-- 消息列表 -->
    <block wx:for="{{messages}}" wx:key="index">
      <view class="msg-wrapper {{item.role === 'user' ? 'msg-right' : 'msg-left'}}">
        <!-- AI 头像 -->
        <view class="msg-avatar" wx:if="{{item.role === 'assistant'}}">🤖</view>

        <view class="msg-body">
          <!-- 消息气泡 -->
          <view class="msg-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
            <text class="msg-text">{{item.content}}</text>
          </view>

          <!-- 新闻引用卡片 -->
          <view
            class="source-card"
            wx:if="{{item.role === 'assistant' && item.sources && item.sources.length > 0}}"
          >
            <view class="source-title">📰 相关新闻</view>
            <view
              class="source-item"
              wx:for="{{item.sources}}"
              wx:for-item="src"
              wx:key="url"
              data-url="{{src.url}}"
              bindtap="onSourceTap"
            >
              <text class="source-item-title">{{src.title}}</text>
              <text class="source-item-from">{{src.source}}</text>
            </view>
          </view>
        </view>

        <!-- 用户头像 -->
        <view class="msg-avatar" wx:if="{{item.role === 'user'}}">👤</view>
      </view>
    </block>

    <!-- 加载中指示器 -->
    <view class="typing-indicator" wx:if="{{loading}}">
      <view class="msg-avatar">🤖</view>
      <view class="typing-dots">
        <view class="dot"></view>
        <view class="dot"></view>
        <view class="dot"></view>
      </view>
    </view>

    <view id="msg-bottom"></view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="chat-footer">
    <input
      class="chat-input"
      value="{{inputValue}}"
      placeholder="输入新闻相关的问题..."
      bindinput="onInput"
      bindconfirm="onSend"
      confirm-type="send"
      maxlength="500"
      focus="{{inputFocus}}"
    />
    <button
      class="send-btn {{inputValue ? 'active' : ''}}"
      bindtap="onSend"
      disabled="{{!inputValue || loading}}"
    >发送</button>
  </view>
</view>
