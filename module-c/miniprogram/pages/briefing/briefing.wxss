/* ── 专属简报页 v2 — 全屏布局 ── */
.container {
  padding: 0;
  min-height: 100vh;
  background: var(--bg-page);
  display: flex;
  flex-direction: column;
}

/* ══════ 🎯 专属简报区 ══════ */
.personal-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ── 输入面板 — 全屏填充 ── */
.pz-input {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--gradient-personal);
  padding: 0;
  box-shadow: none;
  border-radius: 0;
}

/* ── 装饰头部 ── */
.pz-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 40rpx 20rpx;
}
.pz-hero-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: floatIcon 3s ease-in-out infinite;
}
@keyframes floatIcon {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.pz-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}
.pz-hero-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.55);
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ── 主体表单区 ── */
.pz-form {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 32rpx;
  max-width: 640rpx;
  width: 100%;
  margin: 0 auto;
  box-sizing: border-box;
}

/* ── 输入框容器 ── */
.pz-textarea-wrap {
  position: relative;
  margin-bottom: 20rpx;
}
.pz-textarea {
  width: 100%;
  min-height: 160rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 24rpx;
  color: #fff;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255,255,255,0.12);
  transition: border-color 0.2s var(--ease-out);
  line-height: 1.6;
}
.pz-textarea:focus {
  border-color: rgba(255,255,255,0.4);
  background: rgba(255,255,255,0.14);
}
.pz-textarea::placeholder { color: rgba(255,255,255,0.35); }
.pz-char-count {
  position: absolute;
  bottom: 12rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

/* ── 快速标签 ── */
.pz-quick-tags {
  margin-bottom: 24rpx;
}
.pz-qt-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  display: block;
  margin-bottom: 12rpx;
}
.pz-qt-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.pz-qt {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
  background: rgba(255,255,255,0.1);
  padding: 10rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
  transition: all 0.2s var(--ease-out);
}
.pz-qt:active { transform: scale(0.95); }
.pz-qt.on {
  background: rgba(255,255,255,0.92);
  color: var(--primary-deep);
  font-weight: 700;
  border-color: rgba(255,255,255,0.3);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* ── 生成按钮 ── */
.pz-gen-btn {
  width: 100%;
  background: var(--gradient-accent);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 26rpx;
  border: none;
  box-shadow: 0 6rpx 24rpx rgba(245,158,11,0.35);
  transition: all 0.2s var(--ease-out);
}
.pz-gen-btn:active { transform: scale(0.98); opacity: 0.9; }
.pz-gen-btn[disabled] {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.3);
  box-shadow: none;
  opacity: 0.7;
}

/* ── 底部提示 ── */
.pz-footer-hint {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  padding: 20rpx 40rpx 40rpx;
  font-size: 20rpx;
  color: rgba(255,255,255,0.3);
}

/* ── 简报结果卡片 ── */
.pz-result {
  flex: 1;
  background: var(--bg-card);
  overflow-y: auto;
  animation: fadeInUp 0.4s var(--ease-out) both;
  display: flex;
  flex-direction: column;
  padding-bottom: 20rpx;
}
.pz-result-hd {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 24rpx 0;
  flex-wrap: wrap;
  flex-shrink: 0;
}
.pz-badge { font-size: 26rpx; font-weight: 700; color: var(--primary-indigo); background: #eef2ff; padding: 6rpx 18rpx; border-radius: 8rpx; }
.pz-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.pz-t { font-size: 20rpx; background: #f0f0ff; color: var(--primary-indigo); padding: 4rpx 12rpx; border-radius: 10rpx; }

/* 头条 */
.pz-headline {
  position: relative; margin: 16rpx 20rpx 0; border-radius: 16rpx;
  overflow: hidden; min-height: 200rpx; background: var(--bg-dark);
  transition: transform 0.2s var(--ease-out);
}
.pz-headline:active { transform: scale(0.985); }
.pz-hl-img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  opacity: 0.35; object-fit: cover;
}
.pz-hl-overlay {
  position: relative; z-index: 1; padding: 28rpx;
  background: linear-gradient(0deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.1) 100%);
  min-height: 200rpx; display: flex; flex-direction: column; justify-content: flex-end;
}
.pz-hl-badge {
  display: inline-block; font-size: 20rpx;
  background: rgba(245,158,11,0.25); color: #fbbf24;
  padding: 4rpx 16rpx; border-radius: 8rpx; margin-bottom: 12rpx;
  font-weight: 700; align-self: flex-start;
}
.pz-hl-title {
  font-size: 34rpx; font-weight: 800; color: #fff; display: block;
  line-height: 1.3; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}
.pz-hl-summary {
  font-size: 24rpx; color: #cbd5e1; display: block;
  margin-top: 8rpx; line-height: 1.5;
}

/* 区块 */
.pz-sec-title {
  font-size: 32rpx; font-weight: 800; color: var(--text-primary);
  position: relative; padding-left: 20rpx; letter-spacing: 0.5rpx;
}
.pz-sec-title::before {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 6rpx; height: 28rpx; border-radius: 3rpx;
  background: linear-gradient(180deg, var(--primary), var(--primary-purple));
}

/* TL;DR */
.pz-tldr { padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--border-lighter); }
.pz-tldr-item {
  display: flex; gap: 10rpx; padding: 8rpx 0; font-size: 26rpx;
  color: var(--text-secondary); line-height: 1.5; align-items: flex-start;
  transition: background 0.15s;
}
.pz-dot { color: var(--primary-indigo); font-weight: 700; flex-shrink: 0; margin-top: 2rpx; }

/* Sections */
.pz-section { border-bottom: 1rpx solid var(--border-lighter); }
.pz-sec-hd {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 24rpx; transition: background 0.15s;
}
.pz-sec-hd:active { background: var(--bg-card-hover); }
.pz-sec-count { font-size: 22rpx; color: var(--text-tertiary); }
.pz-sec-items { padding: 0 24rpx 16rpx; }

/* 文章条目 */
.pz-art {
  display: flex; gap: 14rpx; padding: 14rpx 0;
  border-top: 1rpx solid #f8fafc;
  transition: all 0.15s var(--ease-out);
}
.pz-art:active { background: var(--bg-card-hover); border-radius: 8rpx; padding-left: 8rpx; padding-right: 8rpx; }
.pz-art-img {
  width: 120rpx; height: 80rpx; border-radius: 10rpx;
  flex-shrink: 0; background: #f1f5f9;
}
.pz-art-body { flex: 1; min-width: 0; }
.pz-art-title {
  font-size: 26rpx; font-weight: 600; color: var(--text-primary);
  display: block; margin-bottom: 4rpx; line-height: 1.4;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.pz-art-sum {
  font-size: 22rpx; color: var(--text-tertiary);
  display: block; margin-bottom: 6rpx;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
}
.pz-art-meta { display: flex; gap: 6rpx; flex-wrap: wrap; }
.pz-art-src { font-size: 20rpx; color: var(--text-tertiary); }
.pz-art-tag { font-size: 18rpx; background: #f1f5f9; color: #64748b; padding: 2rpx 8rpx; border-radius: 4rpx; }
.pz-art-score { font-size: 20rpx; color: #f59e0b; font-weight: 600; margin-left: auto; }

/* 趋势信号 */
.pz-takeaways { padding: 20rpx 24rpx; }

/* 生成新简报按钮 */
.pz-new-btn {
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, var(--primary-indigo), var(--primary-purple));
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 22rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(99,102,241,0.25);
  transition: all 0.2s var(--ease-out);
  flex-shrink: 0;
}
.pz-new-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ══════ 活标签 ══════ */
.live-tags-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.live-tags-hint {
  font-size: 20rpx;
  color: rgba(255,255,255,0.4);
  flex-shrink: 0;
}
.live-tag {
  font-size: 20rpx;
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.85);
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,0.15);
  transition: all 0.2s var(--ease-out);
}
.live-tag:active {
  background: rgba(255,100,100,0.25);
  border-color: rgba(255,100,100,0.5);
  transform: scale(0.95);
}

/* ══════ 生成蒙层 ══════ */
.gen-overlay {
  position: fixed; top:0; left:0; right:0; bottom:0;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
.gen-card {
  background: var(--bg-card); border-radius: 28rpx;
  padding: 48rpx 40rpx; width: 540rpx; text-align: center;
  box-shadow: var(--shadow-float);
  animation: fadeInUp 0.35s var(--ease-out) both;
}
.gen-spinner {
  width: 56rpx; height: 56rpx; margin: 0 auto 28rpx;
  border: 4rpx solid #e8e8e8; border-top-color: var(--primary-indigo);
  border-radius: 50%; animation: spin 0.7s linear infinite;
}
.gen-text { display: block; font-size: 30rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 24rpx; }
.gen-bar { width: 100%; height: 8rpx; background: #eee; border-radius: 4rpx; margin-bottom: 16rpx; overflow: hidden; }
.gen-fill {
  height: 100%; background: linear-gradient(90deg, var(--primary-indigo), var(--primary-purple));
  border-radius: 4rpx; transition: width 0.6s var(--ease-out);
}
.gen-time { display: block; font-size: 24rpx; color: var(--text-tertiary); margin-bottom: 24rpx; }
.gen-cancel {
  background: var(--bg-page); color: var(--text-tertiary);
  font-size: 24rpx; padding: 12rpx 48rpx; border-radius: 12rpx; border: none;
  transition: all 0.15s;
}
.gen-cancel:active { background: #fee2e2; color: var(--accent-red); }
