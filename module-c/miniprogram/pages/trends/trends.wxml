<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在分析事件趋势...</text>
  </view>

  <!-- 错误 -->
  <view wx:elif="{{error}}" class="empty-state" bindtap="fetchTrends">
    <text class="empty-icon">⚠️</text>
    <text class="empty-text">加载失败，点击重试</text>
  </view>

  <!-- 趋势数据 -->
  <view wx:else class="trends-content">

    <!-- 统计概览 -->
    <view class="trend-stats-row">
      <view class="tstat-card">
        <text class="tstat-value">{{timeline.length}}</text>
        <text class="tstat-label">覆盖天数</text>
      </view>
      <view class="tstat-card">
        <text class="tstat-value">{{totalEvents}}</text>
        <text class="tstat-label">精选事件</text>
      </view>
      <view class="tstat-card">
        <text class="tstat-value">{{hotTags.length}}</text>
        <text class="tstat-label">热门标签</text>
      </view>
      <view class="tstat-card">
        <text class="tstat-value">📰</text>
        <text class="tstat-label">{{period}}</text>
      </view>
    </view>

    <!-- 🔥 热门标签 -->
    <view class="hot-tags-bar" wx:if="{{hotTags.length}}">
      <text class="hot-tags-label">🔥 本周热词：</text>
      <scroll-view scroll-x class="hot-tags-scroll">
        <text wx:for="{{hotTags}}" wx:key="tag" class="hot-tag-chip" bindtap="onTagTap" data-tag="{{item.tag}}">
          {{item.label_zh || item.tag}} {{item.count}}
        </text>
      </scroll-view>
    </view>

    <!-- 🤖 AI 周趋势分析 -->
    <view class="weekly-card" wx:if="{{weeklyCommentary}}">
      <view class="weekly-header">
        <text class="weekly-icon">🤖</text>
        <text class="weekly-title">AI 周趋势洞察</text>
      </view>
      <text class="weekly-text">{{weeklyCommentary}}</text>
    </view>

    <!-- 📅 每日事件时间线 -->
    <view class="timeline">
      <view wx:for="{{timeline}}" wx:key="date" class="day-card">
        <!-- 日期头部 -->
        <view class="day-header" bindtap="onDayToggle" data-date="{{item.date}}">
          <view class="day-header-left">
            <view class="day-dot {{item.day_label === '今天' ? 'dot-today' : ''}}"></view>
            <view class="day-info">
              <text class="day-label">{{item.day_label}}</text>
              <text class="day-date">{{item.date_display}}</text>
            </view>
          </view>
          <view class="day-header-right">
            <text class="day-count">{{item.event_count}} 件事</text>
            <text class="day-arrow">{{expandedDays[item.date] ? '▼' : '▶'}}</text>
          </view>
        </view>

        <!-- AI 日摘要 -->
        <view class="day-summary" wx:if="{{item.ai_summary && expandedDays[item.date]}}">
          <text class="day-summary-text">🤖 {{item.ai_summary}}</text>
        </view>

        <!-- 事件列表 -->
        <view class="day-events" wx:if="{{expandedDays[item.date]}}">
          <view wx:for="{{item.events}}" wx:key="title" wx:for-item="event" class="event-item" bindtap="onEventTap" data-url="{{event.url}}">
            <view class="event-score">{{event.score}}</view>
            <view class="event-body">
              <text class="event-title">{{event.title}}</text>
              <text class="event-summary">{{event.summary}}</text>
              <view class="event-meta">
                <text class="event-source">{{event.source}}</text>
                <text wx:for="{{event.tags}}" wx:key="*this" wx:for-item="tag" class="event-tag" catchtap="onTagTap" data-tag="{{tag}}">{{tag}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{!timeline.length}}" class="empty-state">
      <text class="empty-icon">📊</text>
      <text class="empty-text">暂无趋势数据，需要积累多天简报</text>
    </view>

    <!-- 底部提示 -->
    <view class="trend-footer">
      <text>每日自动汇总 · 点击事件可复制链接 · 点击标签搜索历史</text>
    </view>
  </view>
</view>
