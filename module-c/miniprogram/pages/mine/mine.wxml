<view class="container">

  <!-- ══════ 用户头像区 ══════ -->
  <view class="user-hero">
    <view class="user-avatar">U</view>
    <text class="user-id">{{openidMasked}}</text>
  </view>

  <!-- ══════ 统计卡片 ══════ -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-num">{{stats.myBriefings}}</text>
      <text class="stat-label">专属简报</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.followedTags}}</text>
      <text class="stat-label">关注标签</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.subscribed ? '✓' : '-'}}</text>
      <text class="stat-label">推送订阅</text>
    </view>
    <view class="stat-card" bindtap="onGoVideo">
      <text class="stat-num">{{stats.videoCount || '-'}}</text>
      <text class="stat-label">生成视频</text>
    </view>
  </view>

  <!-- ══════ 推送设置 ══════ -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">📢 推送设置</text>
      <text class="card-hint">公众号模板消息</text>
    </view>
    <view class="push-item">
      <view class="push-info">
        <text class="push-label">☀️ 早报推送</text>
        <text class="push-desc">每日上午接收通用早报</text>
      </view>
      <switch checked="{{pushMorning}}" bindchange="onToggleMorning" color="#6366f1" />
    </view>
    <view class="push-item">
      <view class="push-info">
        <text class="push-label">🌙 晚报推送</text>
        <text class="push-desc">每日傍晚接收通用晚报</text>
      </view>
      <switch checked="{{pushEvening}}" bindchange="onToggleEvening" color="#6366f1" />
    </view>
  </view>

  <!-- ══════ 兴趣标签 ══════ -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">🏷️ 我的兴趣</text>
      <text class="card-hint" wx:if="{{selectedTags.length}}">{{selectedTags.length}}个已选</text>
    </view>
    <view class="tag-cloud">
      <view wx:for="{{allTags}}" wx:key="tag"
        class="tag-pill {{item.selected ? 'on' : ''}} {{item.isUserTag ? 'user-tag' : ''}}"
        data-tag="{{item.tag}}" bindtap="onTagTap"
      >
        <text class="tp-emoji">{{item.selected ? '✓' : ''}}</text>
        <text class="tp-label">{{item.label_zh}}</text>
        <text wx:if="{{item.isUserTag}}" class="tp-badge">我的</text>
        <text class="tp-del" data-tag="{{item.tag}}" data-action="remove" catchtap="onRemoveTag">✕</text>
      </view>
    </view>
    <button class="save-btn" bindtap="onSavePreferences">
      保存兴趣 → 首页看专属简报
    </button>
  </view>

  <!-- ══════ 最近专属简报 ══════ -->
  <view class="card" wx:if="{{recentBriefings.length > 0}}">
    <view class="card-head">
      <text class="card-title">📋 最近专属简报</text>
      <text class="card-link" bindtap="onViewAllBriefings">查看全部 →</text>
    </view>
    <view wx:for="{{recentBriefings}}" wx:key="id" class="recent-item" bindtap="onBriefingTap" data-id="{{item.id}}">
      <view class="recent-type {{item.type}}">{{item.type === 'morning' ? '☀️' : '🌙'}}</view>
      <view class="recent-body">
        <text class="recent-interest">{{item.interest_text || '专属简报'}}</text>
        <text class="recent-date">{{item.date}}</text>
      </view>
      <text class="recent-arrow">→</text>
    </view>
  </view>

  <!-- ══════ 设置 ══════ -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">⚙️ 设置</text>
    </view>
    <view class="setting-item" bindtap="onClearCache">
      <text class="setting-label">🗑️ 清除本地缓存</text>
      <text class="setting-desc">标签偏好、活标签</text>
      <text class="setting-arrow">→</text>
    </view>
    <view class="setting-item" bindtap="onAbout">
      <text class="setting-label">ℹ️ 关于</text>
      <text class="setting-desc">AI 资讯简报 v2.0</text>
      <text class="setting-arrow">→</text>
    </view>
  </view>

</view>
