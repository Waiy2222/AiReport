/* ══════════════════════════════════════════
   历史页 — 简报列表 v2.1
   ══════════════════════════════════════════ */

page {
  background: var(--bg-page);
}

.container {
  padding: 20rpx 24rpx 40rpx;
  min-height: 100vh;
}

/* ══════════════════════════════════════════
   搜索栏
   ══════════════════════════════════════════ */
.search-bar {
  margin-bottom: 20rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 48rpx;
  padding: 0 28rpx;
  height: 92rpx;
  box-shadow: var(--shadow-xs);
  border: 2rpx solid transparent;
  transition: all 0.3s var(--ease-out);
}

.search-box:focus-within {
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(74, 108, 247, 0.08), 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 14rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-tertiary);
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-tertiary);
  padding: 14rpx;
  border-radius: 50%;
  transition: all 0.15s;
}
.search-clear:active {
  background: #fee2e2;
  color: var(--accent-red);
}

/* ══════════════════════════════════════════
   筛选栏
   ══════════════════════════════════════════ */
.filter-bar {
  margin-bottom: 18rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
  flex-wrap: wrap;
}

.filter-divider {
  width: 2rpx;
  height: 28rpx;
  background: var(--border-lighter);
  margin: 0 4rpx;
}

.filter-chip {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-lighter);
  white-space: nowrap;
  transition: all 0.2s var(--ease-out);
  font-weight: 500;
}

.filter-chip:active {
  transform: scale(0.95);
}

.filter-chip.active {
  background: linear-gradient(135deg, var(--primary-light), rgba(74, 108, 247, 0.15));
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(74,108,247,0.1);
}

/* 主切换按钮 */
.main-toggle { gap: 12rpx; margin-bottom: 20rpx; }
.main-chip {
  flex: 1; text-align: center; font-size: 28rpx; padding: 16rpx 20rpx;
  border-radius: 14rpx; font-weight: 600;
}
.main-chip.active {
  background: linear-gradient(135deg, var(--primary-indigo), var(--primary-purple));
  color: #fff; border-color: transparent;
  box-shadow: 0 4rpx 16rpx rgba(99,102,241,0.25);
}

/* 标签行 — 水平滚动避免溢出 */
.tag-row-scroll {
  width: 100%;
  white-space: nowrap;
}
.tag-row-wrap {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 0;
}

.tag-chip {
  font-size: 22rpx;
  padding: 10rpx 20rpx;
}

/* 清除筛选 */
.clear-filters {
  text-align: right;
  font-size: 22rpx;
  color: var(--accent-red);
  padding: 8rpx 4rpx 4rpx;
  font-weight: 500;
}

/* ══════════════════════════════════════════
   统计摘要
   ══════════════════════════════════════════ */
.history-summary {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.hstat-item {
  flex: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border-lighter);
  transition: transform 0.2s var(--ease-out);
  position: relative; overflow: hidden;
}

.hstat-item:active {
  transform: scale(0.97);
}

.hstat-item::before {
  content: ''; position: absolute; top: -16rpx; right: -16rpx;
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--primary-light); opacity: 0.35;
}

.hstat-num {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary), var(--primary-purple));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative; z-index: 1;
}

.hstat-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 6rpx;
  font-weight: 500;
  position: relative; z-index: 1;
}

/* ── 搜索结果提示 ── */
.result-hint {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.fw600 {
  font-weight: 700;
  color: var(--primary);
}

/* ══════════════════════════════════════════
   简报卡片列表
   ══════════════════════════════════════════ */
.history-list {
  /* container */
}

.hcard {
  background: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border-lighter);
  transition: all 0.2s var(--ease-out);
}

.hcard:active {
  box-shadow: var(--shadow-md);
  transform: scale(0.985);
}

/* ── 卡片头部 ── */
.hcard-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.hcard-type {
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  letter-spacing: 0.01em;
}

.hcard-type.morning {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  color: #ea580c;
  border: 1rpx solid #fed7aa;
}

.hcard-type.evening {
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
  color: #4f46e5;
  border: 1rpx solid #c7d2fe;
}

.hcard-date {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.hcard-ago {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-left: auto;
}

/* ── TL;DR 要点预览 ── */
.hcard-points {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--bg-page);
  border-radius: var(--radius-md);
}

.hcard-point {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
}

.hpoint-dot {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* ── 标签行 ── */
.hcard-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.hcard-tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, rgba(74, 108, 247, 0.08), rgba(99, 102, 241, 0.06));
  color: var(--primary);
  border: 1rpx solid rgba(74, 108, 247, 0.15);
  font-weight: 500;
}

/* ── 个性化卡片标记 ── */
.personalized-card-tag {
  font-size: 22rpx;
  color: var(--primary-indigo);
  background: linear-gradient(135deg, #f0f4ff, #eef2ff);
  border-radius: 10rpx;
  padding: 10rpx 18rpx;
  margin-bottom: 14rpx;
  border-left: 4rpx solid var(--primary-indigo);
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

/* ── 卡片底部 ── */
.hcard-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--border-lighter);
}

.hcard-more {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.hcard-arrow {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* ══════════════════════════════════════════
   加载
   ══════════════════════════════════════════ */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

/* ══════════════════════════════════════════
   空状态
   ══════════════════════════════════════════ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-hint {
  margin-top: 24rpx;
  color: var(--primary);
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  background: var(--primary-light);
  border-radius: var(--radius-full);
}

/* ── 搜索无结果建议 ── */
.search-suggestions { margin-top: 28rpx; text-align: center; }
.suggest-label { font-size: 24rpx; color: var(--text-tertiary); display: block; margin-bottom: 14rpx; }
.suggest-chips { display: flex; flex-wrap: wrap; gap: 10rpx; justify-content: center; }
.suggest-chip {
  font-size: 24rpx; color: var(--primary); background: var(--primary-light);
  border-radius: var(--radius-full); padding: 10rpx 24rpx;
  border: 1rpx solid rgba(74,108,247,0.15);
}

.filter-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-right: 8rpx;
  line-height: 48rpx;
}
