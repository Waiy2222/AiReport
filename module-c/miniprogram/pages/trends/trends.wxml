<view class="container">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在分析你的专属趋势...</text>
  </view>

  <!-- 无数据 -->
  <view wx:elif="{{!loading && timeline.length === 0}}" class="empty-state">
    <text class="empty-icon">📭</text>
    <text class="empty-title">还没有专属趋势</text>
    <text class="empty-desc">去首页生成你的专属简报，AI 会为你追踪趋势</text>
    <button class="empty-btn" bindtap="onGoGenerate">✨ 去生成</button>
  </view>

  <!-- 趋势数据 -->
  <view wx:else class="dashboard">

    <!-- 🎯 兴趣标签 -->
    <view wx:if="{{personalizedTags.length > 0}}" class="interest-hero">
      <text class="ih-icon">🎯</text>
      <view class="ih-body">
        <text class="ih-title">你的专属趋势</text>
        <view class="ih-tags">
          <text wx:for="{{personalizedTags}}" wx:key="*this" class="ih-tag">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 📊 数据概览 -->
    <view class="stats-row">
      <view class="stat">
        <text class="stat-num">{{totalEvents}}</text>
        <text class="stat-label">追踪事件</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{timeline.length}}</text>
        <text class="stat-label">活跃天数</text>
      </view>
      <view class="stat">
        <text class="stat-num">{{hotTags.length}}</text>
        <text class="stat-label">关注标签</text>
      </view>
    </view>

    <!-- 🧠 AI 趋势判断 -->
    <view wx:if="{{weeklyCommentary}}" class="insight-card">
      <view class="insight-header">
        <text class="insight-icon">🧠</text>
        <text class="insight-label">AI 趋势判断</text>
      </view>
      <text class="insight-text">{{weeklyCommentary}}</text>
    </view>

    <!-- 📡 关注领域热度 -->
    <view class="section-title">📡 关注领域</view>
    <view class="radar-list" wx:if="{{hotTags.length}}">
      <view wx:for="{{hotTags}}" wx:key="tag" class="radar-item">
        <text class="radar-name">{{item.label_zh || item.tag}}</text>
        <view class="radar-bar">
          <view class="radar-fill" style="width: {{item.count * 10 > 100 ? 100 : item.count * 10}}%"></view>
        </view>
        <text class="radar-count">{{item.count}}</text>
      </view>
    </view>

    <!-- 📅 时间线 -->
    <view class="section-title">📅 每日回顾</view>
    <view class="timeline">
      <view wx:for="{{timeline}}" wx:key="date" class="tl-day" bindtap="onDayToggle" data-date="{{item.date}}">
        <view class="tl-dot-wrap">
          <view class="tl-dot {{item.day_label === '今天' ? 'today' : ''}}"></view>
          <view wx:if="{{index < timeline.length - 1}}" class="tl-line"></view>
        </view>
        <view class="tl-card">
          <view class="tl-date-row">
            <text class="tl-day-label">{{item.day_label}}</text>
            <text class="tl-date">{{item.date_display}}</text>
            <text class="tl-badge">{{item.event_count}}条</text>
          </view>
          <view wx:if="{{expandedDays[item.date]}}" class="tl-events">
            <view wx:for="{{item.events}}" wx:for-item="ev" wx:key="title" class="tl-event">
              <text class="tl-event-title">{{ev.title}}</text>
              <text class="tl-event-summary">{{ev.summary}}</text>
            </view>
          </view>
          <view wx:if="{{item.ai_summary && expandedDays[item.date]}}" class="tl-insight">
            💡 {{item.ai_summary}}
          </view>
        </view>
      </view>
    </view>

  </view>
</view>
