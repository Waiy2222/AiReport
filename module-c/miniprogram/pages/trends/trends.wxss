.container { padding: 24rpx; min-height: 100vh; background: #f5f5f5; padding-bottom: 48rpx; }

/* ── 加载/空状态 ── */
.loading, .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 200rpx; }
.loading-spinner { width: 60rpx; height: 60rpx; border: 4rpx solid #e0e0e0; border-top-color: #667eea; border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 20rpx; color: #999; font-size: 28rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 28rpx; color: #999; }

/* ── 统计概览 ── */
.trend-stats-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.tstat-card { flex: 1; background: #fff; border-radius: 16rpx; padding: 20rpx 10rpx; text-align: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.tstat-value { display: block; font-size: 40rpx; font-weight: 700; color: #1a1a2e; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tstat-label { font-size: 22rpx; color: #999; margin-top: 2rpx; }

/* ── 热门标签条 ── */
.hot-tags-bar { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.03); }
.hot-tags-label { font-size: 26rpx; color: #e64a4a; font-weight: 600; white-space: nowrap; margin-right: 12rpx; }
.hot-tags-scroll { display: flex; flex: 1; white-space: nowrap; }
.hot-tag-chip { display: inline-block; background: #f5f3ff; color: #5b3ea8; font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 20rpx; margin-right: 10rpx; font-weight: 500; }

/* ── AI 周趋势卡片 ── */
.weekly-card { background: linear-gradient(135deg, #667eea15, #764ba215); border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; border: 1rpx solid #e8e0f0; }
.weekly-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.weekly-icon { font-size: 36rpx; }
.weekly-title { font-size: 30rpx; font-weight: 700; color: #5b3ea8; }
.weekly-text { font-size: 27rpx; color: #445; line-height: 1.7; }

/* ── 时间线 ── */
.timeline { position: relative; }

/* 左侧竖线 */
.timeline::before { content: ''; position: absolute; left: 22rpx; top: 0; bottom: 0; width: 3rpx; background: #e0e0e0; }

/* ── 每日卡片 ── */
.day-card { margin-bottom: 20rpx; position: relative; padding-left: 52rpx; }

/* 日期头部 */
.day-header { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.day-header-left { display: flex; align-items: center; gap: 14rpx; }
.day-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #ccc; border: 3rpx solid #fff; box-shadow: 0 0 0 3rpx #e0e0e0; position: absolute; left: 14rpx; top: 28rpx; }
.dot-today { background: #667eea; box-shadow: 0 0 0 3rpx #c4b5fd; }
.day-info { display: flex; flex-direction: column; }
.day-label { font-size: 30rpx; font-weight: 700; color: #1a1a2e; }
.day-date { font-size: 24rpx; color: #999; margin-top: 2rpx; }
.day-header-right { display: flex; align-items: center; gap: 12rpx; }
.day-count { font-size: 24rpx; color: #999; }
.day-arrow { font-size: 22rpx; color: #ccc; }

/* AI 日摘要 */
.day-summary { background: linear-gradient(135deg, #f5f3ff, #ede9fe); border-radius: 0 0 16rpx 16rpx; padding: 16rpx 24rpx; margin-top: -4rpx; }
.day-summary-text { font-size: 26rpx; color: #5b3ea8; line-height: 1.6; }

/* 事件列表 */
.day-events { background: #fafafa; border-radius: 0 0 16rpx 16rpx; padding: 8rpx 8rpx 0; margin-top: -4rpx; }
.event-item { display: flex; gap: 12rpx; background: #fff; border-radius: 12rpx; padding: 16rpx 18rpx; margin: 8rpx 0; box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.02); }
.event-score { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; border-radius: 10rpx; font-size: 24rpx; font-weight: 700; flex-shrink: 0; align-self: flex-start; }
.event-body { flex: 1; min-width: 0; }
.event-title { font-size: 28rpx; font-weight: 600; color: #1a1a2e; line-height: 1.5; display: block; margin-bottom: 6rpx; }
.event-summary { font-size: 24rpx; color: #666; line-height: 1.5; display: block; margin-bottom: 8rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.event-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx; }
.event-source { font-size: 22rpx; color: #999; background: #f5f5f5; padding: 2rpx 10rpx; border-radius: 6rpx; }
.event-tag { font-size: 20rpx; color: #667eea; background: #f0f0ff; padding: 2rpx 10rpx; border-radius: 6rpx; }

/* ── 底部 ── */
.trend-footer { text-align: center; padding: 30rpx 0; font-size: 22rpx; color: #ccc; }
