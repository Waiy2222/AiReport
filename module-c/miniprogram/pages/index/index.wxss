/* ── 首页 v8 — 我的报道（早晚自动切换）── */
.container { padding: 20rpx 24rpx 80rpx; min-height: 100vh; background: var(--bg-page); }

/* ══════ 头部 ══════ */
.report-hd { margin-bottom: 16rpx; }
.report-header-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 4rpx;
}
.report-title-row { display: flex; align-items: center; gap: 10rpx; }
.report-emoji { font-size: 36rpx; }
.report-title { font-size: 36rpx; font-weight: 800; color: var(--text-primary); }
.report-time {
  font-size: 22rpx; color: var(--primary-indigo);
  background: #eef2ff; padding: 6rpx 16rpx; border-radius: 12rpx;
  font-weight: 500;
}

/* ══════ 加载/空状态 ══════ */
.load-row { text-align: center; padding: 80rpx; color: var(--text-tertiary); font-size: 26rpx; }
.empty-prompt {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 40rpx; text-align: center;
}
.empty-icon { font-size: 72rpx; margin-bottom: 16rpx; opacity: 0.6; }
.empty-msg { font-size: 28rpx; color: var(--text-secondary); font-weight: 600; margin-bottom: 8rpx; }
.empty-hint { font-size: 24rpx; color: var(--text-tertiary); }

/* ══════ 报道卡片 ══════ */
.report-card {
  background: var(--bg-card); border-radius: var(--radius-card);
  overflow: hidden; box-shadow: var(--shadow-card);
  animation: fadeInUp 0.4s var(--ease-out) both;
}

/* ── 头条 ── */
.rp-headline {
  position: relative; overflow: hidden; min-height: 220rpx; background: var(--bg-dark);
  transition: transform 0.2s var(--ease-out);
}
.rp-headline:active { transform: scale(0.985); }
.rp-hl-img {
  position: absolute; top: 0; left: 0; width: 100%; height: 100%;
  opacity: 0.3; object-fit: cover;
}
.rp-hl-overlay {
  position: relative; z-index: 1; padding: 32rpx 28rpx;
  background: linear-gradient(0deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.05) 100%);
  min-height: 220rpx; display: flex; flex-direction: column; justify-content: flex-end;
}
.rp-hl-badge {
  display: inline-block; font-size: 20rpx;
  background: rgba(245,158,11,0.25); color: #fbbf24;
  padding: 4rpx 16rpx; border-radius: 8rpx; margin-bottom: 12rpx;
  font-weight: 700; align-self: flex-start;
}
.rp-hl-title {
  font-size: 36rpx; font-weight: 800; color: #fff; display: block;
  line-height: 1.3; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.5);
}
.rp-hl-summary {
  font-size: 24rpx; color: #cbd5e1; display: block;
  margin-top: 8rpx; line-height: 1.5;
}

/* ── TL;DR ── */
.rp-tldr { padding: 20rpx 24rpx; border-bottom: 1rpx solid var(--border-lighter); }
.rp-tldr-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); display: block; margin-bottom: 8rpx; }
.rp-tldr-item {
  display: flex; gap: 10rpx; padding: 6rpx 0; font-size: 26rpx;
  color: var(--text-secondary); line-height: 1.5; align-items: flex-start;
}
.rp-dot { color: var(--primary-indigo); font-weight: 700; flex-shrink: 0; margin-top: 3rpx; }

/* ── 兴趣标签 ── */
.rp-tags { display: flex; flex-wrap: wrap; gap: 8rpx; padding: 14rpx 24rpx; border-bottom: 1rpx solid var(--border-lighter); }
.rp-tag { font-size: 20rpx; background: #eef2ff; color: var(--primary-indigo); padding: 4rpx 12rpx; border-radius: 10rpx; }

/* ── Sections ── */
.rp-section { border-bottom: 1rpx solid var(--border-lighter); }
.rp-sec-hd {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 24rpx; transition: background 0.15s;
}
.rp-sec-hd:active { background: var(--bg-card-hover); }
.rp-sec-title {
  font-size: 32rpx; font-weight: 800; color: var(--text-primary);
  position: relative; padding-left: 20rpx; letter-spacing: 0.5rpx;
}
.rp-sec-title::before {
  content: ''; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 6rpx; height: 28rpx; border-radius: 3rpx;
  background: linear-gradient(180deg, var(--primary-indigo), var(--primary-purple));
}
.rp-sec-count { font-size: 22rpx; color: var(--text-tertiary); }
.rp-sec-items { padding: 0 24rpx 16rpx; }

/* ── 文章条目 ── */
.rp-art {
  display: flex; gap: 14rpx; padding: 14rpx 0;
  border-top: 1rpx solid #f8fafc;
  transition: all 0.15s var(--ease-out);
}
.rp-art:active { background: var(--bg-card-hover); border-radius: 8rpx; padding-left: 8rpx; padding-right: 8rpx; }
.rp-art-img {
  width: 120rpx; height: 80rpx; border-radius: 10rpx;
  flex-shrink: 0; background: #f1f5f9;
}
.rp-art-body { flex: 1; min-width: 0; }
.rp-art-title {
  font-size: 26rpx; font-weight: 600; color: var(--text-primary);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  margin-bottom: 4rpx; line-height: 1.4;
}
.rp-art-sum {
  font-size: 22rpx; color: var(--text-tertiary);
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  margin-bottom: 6rpx;
}
.rp-art-meta { display: flex; gap: 6rpx; flex-wrap: wrap; }
.rp-art-src { font-size: 20rpx; color: var(--text-tertiary); }
.rp-art-tag { font-size: 18rpx; background: #f1f5f9; color: #64748b; padding: 2rpx 8rpx; border-radius: 4rpx; }
.rp-art-score { font-size: 20rpx; color: #f59e0b; font-weight: 600; margin-left: auto; }

/* ── 趋势信号 ── */
.rp-takeaways { padding: 20rpx 24rpx; }
