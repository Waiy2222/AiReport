.container {
  width: 100vw;
  height: 100vh;
  background: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.player-wrap {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.video-player {
  width: 100%;
  height: 100%;
  background: #000;
}

.info-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.8));
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.4;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}

.info-duration {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.info-share {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  border: none;
  line-height: 1.2;
  flex-shrink: 0;
}
