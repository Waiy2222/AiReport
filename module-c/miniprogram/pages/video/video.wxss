.container {
  min-height: 100vh;
  background: var(--bg-page);
}

/* ── 输入区域 ── */
.input-zone {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 40rpx 32rpx 32rpx;
}
.input-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}
.input-icon { font-size: 56rpx; margin-bottom: 8rpx; }
.input-title {
  font-size: 36rpx; font-weight: 800; color: #fff; letter-spacing: 1rpx;
}
.input-sub {
  font-size: 22rpx; color: rgba(255,255,255,0.5); margin-top: 8rpx;
}

.input-row {
  display: flex; gap: 12rpx; align-items: center;
}
.keyword-input {
  flex: 1;
  height: 80rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: #fff;
  font-size: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.12);
}
.keyword-input::placeholder { color: rgba(255,255,255,0.3); }

.gen-btn {
  width: 140rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f59e0b, #f97316);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(245,158,11,0.3);
}
.gen-btn:active { transform: scale(0.95); opacity: 0.9; }
.gen-btn[disabled] {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.3);
  box-shadow: none;
}

/* 快速标签 */
.quick-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 20rpx;
}
.qt-label { font-size: 20rpx; color: rgba(255,255,255,0.4); }
.qt {
  font-size: 22rpx;
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.8);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}
.qt:active {
  background: rgba(255,255,255,0.25);
  transform: scale(0.95);
}

/* ── 列表区域 ── */
.list-zone {
  padding: 24rpx 24rpx 48rpx;
}
.list-header {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.list-count {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}
.empty-icon { font-size: 80rpx; opacity: 0.3; }
.empty-text {
  font-size: 28rpx; color: var(--text-tertiary); margin-top: 16rpx;
}
.empty-hint {
  font-size: 22rpx; color: var(--text-tertiary); opacity: 0.6; margin-top: 8rpx;
}
.loading-state {
  text-align: center; padding: 80rpx 0; color: var(--text-tertiary);
}

/* 视频卡片 */
.video-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.video-card:active {
  transform: scale(0.985);
  background: var(--bg-card-hover);
}
.vc-cover {
  width: 200rpx;
  height: 126rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #e8e8e8;
}
.vc-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.vc-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}
.vc-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
  align-items: center;
}
.vc-status {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.vc-status.done {
  color: #16a34a;
  background: #f0fdf4;
}
.vc-status.pending {
  color: #d97706;
  background: #fffbeb;
}
.vc-duration {
  font-size: 20rpx;
  color: var(--text-tertiary);
}
.vc-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-tertiary);
  background: var(--bg-page);
  border-radius: 50%;
  flex-shrink: 0;
}
.loading-more {
  text-align: center;
  padding: 24rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
}

/* ── 生成蒙层 ── */
.gen-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
.gen-card {
  background: var(--bg-card);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  width: 560rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}
.gen-spinner {
  width: 56rpx; height: 56rpx; margin: 0 auto 28rpx;
  border: 4rpx solid #e8e8e8;
  border-top-color: var(--primary-indigo);
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.gen-text {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
}
.gen-bar {
  width: 100%; height: 8rpx; background: #eee;
  border-radius: 4rpx; margin-bottom: 16rpx; overflow: hidden;
}
.gen-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #f97316);
  border-radius: 4rpx;
  transition: width 0.6s ease-out;
}
.gen-time {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}
.gen-hint {
  display: block;
  font-size: 20rpx;
  color: var(--text-tertiary);
  opacity: 0.6;
  margin-bottom: 24rpx;
}
.gen-cancel {
  background: var(--bg-page);
  color: var(--text-tertiary);
  font-size: 24rpx;
  padding: 12rpx 48rpx;
  border-radius: 12rpx;
  border: none;
}
.gen-cancel:active {
  background: #fee2e2;
  color: #ef4444;
}
