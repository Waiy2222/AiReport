<view class="container">

  <!-- ══════════════════════════════════════════
       我的报道 — 早/晚自动切换
       ══════════════════════════════════════════ -->
  <view class="report-zone">

    <!-- 头部 -->
    <view class="report-hd">
      <view class="report-header-row">
        <view class="report-title-row">
          <text class="report-emoji">{{typeEmoji}}</text>
          <text class="report-title">{{typeLabel}}</text>
        </view>
        <text class="report-time" wx:if="{{timeText}}">{{timeText}}</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="load-row">加载中...</view>

    <!-- 空状态 -->
    <view wx:if="{{!loading && !briefing}}" class="empty-prompt">
      <text class="empty-icon">📭</text>
      <text class="empty-msg">还没有{{typeLabel}}</text>
      <text class="empty-hint">去「专属简报」生成你的第一篇报道吧 ✨</text>
    </view>

    <!-- 报道内容 -->
    <view wx:if="{{briefing && !loading}}" class="report-card">
      <!-- 头条 -->
      <view wx:if="{{briefing.headline && briefing.headline.title}}" class="rp-headline" bindtap="onCardTap">
        <image wx:if="{{headlineItem.image_url && !headlineItem._headImgHide}}" src="{{headlineItem.image_url}}" mode="aspectFill" class="rp-hl-img" binderror="onHeadImageError" />
        <view class="rp-hl-overlay">
          <text class="rp-hl-badge">🔥 头条</text>
          <text class="rp-hl-title">{{briefing.headline.title}}</text>
          <text class="rp-hl-summary">{{briefing.headline.summary}}</text>
        </view>
      </view>

      <!-- TL;DR -->
      <view wx:if="{{briefing.tl_dr && briefing.tl_dr.length > 0}}" class="rp-tldr">
        <text class="rp-tldr-title">📋 今日要点</text>
        <view wx:for="{{briefing.tl_dr}}" wx:key="*this" class="rp-tldr-item">
          <text class="rp-dot">{{index + 1}}</text>
          <text>{{item}}</text>
        </view>
      </view>

      <!-- 兴趣标签 -->
      <view wx:if="{{briefing.interest_tags && briefing.interest_tags.length > 0}}" class="rp-tags">
        <text wx:for="{{briefing.interest_tags}}" wx:key="*this" class="rp-tag">{{item}}</text>
      </view>

      <!-- Sections -->
      <view wx:for="{{briefing.sections}}" wx:key="section_title" wx:for-index="si" class="rp-section">
        <view class="rp-sec-hd" bindtap="onSectionToggle" data-index="{{si}}">
          <text class="rp-sec-title">{{item.section_title}}</text>
          <text class="rp-sec-count">{{item.items.length}}篇 {{sectionsExpanded[si] ? '▾' : '▸'}}</text>
        </view>
        <view wx:if="{{sectionsExpanded[si]}}" class="rp-sec-items">
          <view wx:for="{{item.items}}" wx:for-item="art" class="rp-art" bindtap="onArticleTap">
            <image wx:if="{{art.image_url && !art._imgHide}}" src="{{art.image_url}}" mode="widthFix" class="rp-art-img" lazy-load binderror="onMiniImageError" data-section="{{si}}" data-index="{{index}}" />
            <view class="rp-art-body">
              <text class="rp-art-title">{{art.title}}</text>
              <text class="rp-art-sum">{{art.summary}}</text>
              <view class="rp-art-meta">
                <text class="rp-art-src">{{art.source}}</text>
                <text wx:for="{{art.tags}}" wx:key="*this" wx:for-item="t" class="rp-art-tag">{{t}}</text>
                <text class="rp-art-score" wx:if="{{art.score}}">⭐{{art.score}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 趋势信号 -->
      <view wx:if="{{briefing.key_takeaways && briefing.key_takeaways.length > 0}}" class="rp-takeaways">
        <text class="rp-tldr-title">💡 趋势信号</text>
        <view wx:for="{{briefing.key_takeaways}}" wx:key="*this" class="rp-tldr-item">
          <text class="rp-dot">{{index + 1}}</text>
          <text>{{item}}</text>
        </view>
      </view>
    </view>

  </view>

</view>
