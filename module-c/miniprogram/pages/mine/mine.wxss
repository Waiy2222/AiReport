/* ── 我的 v5 — 个人中心 ── */
.container { padding: 20rpx 24rpx 80rpx; min-height: 100vh; background: var(--bg-page); }

/* ══════ 用户头像区 ══════ */
.user-hero {
  display: flex; flex-direction: column; align-items: center;
  padding: 48rpx 0 24rpx;
  position: relative;
}
.user-hero::before {
  content: '';
  position: absolute; top: 0; left: -24rpx; right: -24rpx;
  height: 180rpx;
  background: linear-gradient(180deg, rgba(99,102,241,0.06) 0%, transparent 100%);
  border-radius: 0 0 40rpx 40rpx;
  z-index: 0;
}
.user-avatar {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-indigo), var(--primary-purple));
  color: #fff; font-size: 36rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(99,102,241,0.3);
  position: relative; z-index: 1;
}
.user-id {
  font-size: 26rpx; color: var(--text-secondary); font-weight: 500;
  position: relative; z-index: 1;
}

/* ══════ 统计卡片 ══════ */
.stats-row {
  display: flex; gap: 16rpx; margin-bottom: 20rpx;
}
.stat-card {
  flex: 1; background: var(--bg-card); border-radius: 16rpx;
  padding: 20rpx 12rpx; text-align: center;
  box-shadow: var(--shadow-xs); border: 1rpx solid var(--border-lighter);
}
.stat-num {
  display: block; font-size: 36rpx; font-weight: 800;
  color: var(--primary-indigo); margin-bottom: 4rpx;
}
.stat-label {
  font-size: 20rpx; color: var(--text-tertiary);
}

/* ══════ 卡片 ══════ */
.card {
  background: var(--bg-card); border-radius: var(--radius-card);
  padding: 24rpx 28rpx; margin-bottom: 20rpx;
  box-shadow: var(--shadow-card); border: 1rpx solid var(--border-lighter);
}
.card-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 20rpx;
}
.card-title { font-size: 30rpx; font-weight: 700; color: var(--text-primary); }
.card-hint { font-size: 22rpx; color: var(--primary-indigo); font-weight: 600; }
.card-link { font-size: 24rpx; color: var(--primary-indigo); font-weight: 500; padding: 4rpx 0; }

/* ══════ 推送设置 ══════ */
.push-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--border-lighter);
}
.push-item:first-of-type { border-top: none; }
.push-info { display: flex; flex-direction: column; gap: 4rpx; }
.push-label { font-size: 28rpx; color: var(--text-primary); font-weight: 500; }
.push-desc { font-size: 22rpx; color: var(--text-tertiary); }

/* ══════ 标签云 ══════ */
.tag-cloud { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag-pill {
  display: flex; align-items: center; gap: 8rpx;
  padding: 12rpx 24rpx; border-radius: 24rpx;
  background: #f1f5f9; border: 2rpx solid transparent;
  font-size: 24rpx; color: #64748b;
  transition: all 0.2s var(--ease-out);
}
.tag-pill:active { transform: scale(0.95); }
.tag-pill.on {
  background: #eef2ff; border-color: var(--primary-indigo);
  color: var(--primary-deep); font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(99,102,241,0.15);
}
.tag-pill.user-tag {
  border-style: dashed;
  border-color: #e2e8f0;
}
.tp-emoji { font-size: 18rpx; width: 24rpx; text-align: center; }
.tp-badge {
  font-size: 16rpx; background: var(--primary-indigo); color: #fff;
  padding: 1rpx 8rpx; border-radius: 6rpx; margin-left: 2rpx;
}
.tp-del {
  font-size: 20rpx; color: #cbd5e1; margin-left: 6rpx;
  padding: 2rpx 6rpx; border-radius: 50%;
  transition: all 0.15s;
}
.tp-del:active { color: var(--accent-red); background: #fee2e2; }

/* ══════ 保存按钮 ══════ */
.save-btn {
  width: 100%; margin-top: 24rpx;
  background: linear-gradient(135deg, var(--primary-indigo), var(--primary-purple));
  color: #fff; font-size: 28rpx; font-weight: 700;
  border-radius: 16rpx; padding: 20rpx; border: none;
  box-shadow: 0 4rpx 16rpx rgba(99,102,241,0.3);
  transition: all 0.2s var(--ease-out);
}
.save-btn:active { transform: scale(0.98); opacity: 0.9; }

/* ══════ 最近专属简报 ══════ */
.recent-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--border-lighter);
  transition: background 0.15s;
}
.recent-item:active { background: var(--bg-card-hover); margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: 8rpx; }
.recent-type {
  font-size: 28rpx; width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 12rpx; flex-shrink: 0;
}
.recent-type.morning { background: #fef3c7; }
.recent-type.evening { background: #e0e7ff; }
.recent-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.recent-interest {
  font-size: 26rpx; font-weight: 600; color: var(--text-primary);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.recent-date { font-size: 22rpx; color: var(--text-tertiary); }
.recent-arrow { font-size: 28rpx; color: var(--text-tertiary); flex-shrink: 0; }

/* ══════ 设置 ══════ */
.setting-item {
  display: flex; align-items: center; gap: 12rpx;
  padding: 18rpx 0; border-top: 1rpx solid var(--border-lighter);
  transition: background 0.15s;
}
.setting-item:first-of-type { border-top: none; }
.setting-item:active { background: var(--bg-card-hover); margin: 0 -12rpx; padding-left: 12rpx; padding-right: 12rpx; border-radius: 8rpx; }
.setting-label { font-size: 28rpx; color: var(--text-primary); font-weight: 500; flex-shrink: 0; }
.setting-desc { font-size: 22rpx; color: var(--text-tertiary); flex: 1; text-align: right; }
.setting-arrow { font-size: 28rpx; color: var(--text-tertiary); flex-shrink: 0; }
